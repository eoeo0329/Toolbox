# ===== 数据安全 =====
# 仅服务器可见，绝不暴露给前端
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
ENCRYPTION_KEY=your-32-char-encryption-key-here!!!

# ===== AI 服务密钥 =====
# 把这里替换成你在 https://platform.deepseek.com/ 申请的真实 Key
# 格式：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_DEEPSEEK=在这里填入你的真实DeepSeek-Key

# OpenAI（暂未使用，可保留占位）
API_KEY_OPENAI=sk-prod-xxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 服务配置 =====
PORT=3001
NODE_ENV=development
# 本地开发允许 Vite 默认端口
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173

# ===== 安全阈值 =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
LOGIN_MAX_ATTEMPTS=5
AUTO_BAN_THRESHOLD=5
RISK_SCORE_THRESHOLD=70
